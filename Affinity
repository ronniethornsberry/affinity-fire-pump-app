              className="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-black uppercase px-6 py-3 rounded tracking-wider shadow-md transition"
            >
              Recommend Setup
            </button>
          </div>
        </section>

        {/* FIELD TEST STAGES GRID */}
        <section className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <FlowStageCard meta={STAGE_METADATA[0]} data={stages.churn} onUpdate={handleStageUpdate} />
          <FlowStageCard meta={STAGE_METADATA[1]} data={stages.rated} onUpdate={handleStageUpdate} />
          <FlowStageCard meta={STAGE_METADATA[2]} data={stages.peak} onUpdate={handleStageUpdate} />
        </section>

        {/* BOTTOM ACTION BUTTONS */}
        <div className="flex flex-col sm:flex-row justify-center gap-4 pt-4">
          <button 
            onClick={() => setActiveModal('report')}
