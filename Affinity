                    <div className="font-bold text-white text-sm">{form.title}</div>
                    <div className="font-mono text-red-400 text-xs my-1">{form.formula}</div>
                    <div className="text-zinc-400 text-xs">{form.desc}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </ModalShell>
      )}

      {/* 3. Vertical Turbine Guide Modal */}
      {activeModal === 'vertical' && (
        <ModalShell title="Vertical Turbine Testing & Suction Lift Guide" onClose={() => setActiveModal(null)}>
          <div className="space-y-4">
            <p className="text-zinc-300 text-sm">When testing vertical turbine fire pumps drawing water from an underground reservoir or tank, measuring negative suction head (static lift and drawdown) is critical for accurate net pressure evaluation per NFPA 25.</p>
            <div className="space-y-3">
              {VERTICAL_TURBINE_STEPS.map((s, idx) => (
                <div key={idx} className="bg-zinc-900 p-3 rounded border border-zinc-800">
                  <div className="font-bold text-red-500 text-sm">{s.step}</div>
                  <div className="text-zinc-300 text-xs mt-1">{s.desc}</div>
                </div>
              ))}
            </div>
          </div>
        </ModalShell>
      )}

      {/* 4. Recommend Setup Modal */}
      {activeModal === 'recommend' && recommendedSetup && (
        <ModalShell title="Recommended Test Setup" onClose={() => setActiveModal(null)}>
          <div className="space-y-4">
            <p className="text-zinc-300 text-sm">{recommendedSetup.note}</p>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div className="bg-zinc-900 p-3 rounded border border-zinc-800 text-center">
                <span className="block text-xs font-bold text-red-400 uppercase">0% Churn Point</span>
                <span className="text-lg font-mono font-bold text-white">{recommendedSetup.churnGpm} GPM</span>
                <span className="block text-xs text-zinc-400 mt-1">Closed Valve</span>
              </div>
              <div className="bg-zinc-900 p-3 rounded border border-zinc-800 text-center">
                <span className="block text-xs font-bold text-red-400 uppercase">100% Rated Point</span>
                <span className="text-lg font-mono font-bold text-white">{recommendedSetup.ratedGpm} GPM</span>
                <span className="block text-xs text-zinc-400 mt-1">Target Pitot: ~{recommendedSetup.ratedPitot} PSI</span>
              </div>
              <div className="bg-zinc-900 p-3 rounded border border-zinc-800 text-center">
                <span className="block text-xs font-bold text-red-400 uppercase">150% Peak Point</span>
                <span className="text-lg font-mono font-bold text-white">{recommendedSetup.peakGpm} GPM</span>
                <span className="block text-xs text-zinc-400 mt-1">Target Pitot: ~{recommendedSetup.peakPitot} PSI</span>
              </div>
            </div>
          </div>
        </ModalShell>
      )}

      {/* 5. Final Test Summary Report Modal */}
      {activeModal === 'report' && (
        <ModalShell title="Final Test Summary Report" onClose={() => setActiveModal(null)}>
          <div className="space-y-6">
            <div className="bg-zinc-900 p-4 rounded border border-zinc-800 space-y-2">
              <h4 className="text-red-500 font-black uppercase text-sm border-b border-zinc-800 pb-1">System Parameters</h4>
              <div className="grid grid-cols-2 sm:grid-cols-3 text-xs gap-2 font-mono">
                <div><span className="text-zinc-400">Location:</span> {sysInfo.testLocation || 'N/A'}</div>
                <div><span className="text-zinc-400">Rated GPM:</span> {sysInfo.ratedGpm || '0'}</div>
                <div><span className="text-zinc-400">Rated PSI:</span> {sysInfo.ratedPsi || '0'}</div>
                <div><span className="text-zinc-400">Rated RPM:</span> {sysInfo.ratedRpm || 'N/A'}</div>
                <div><span className="text-zinc-400">BHP:</span> {sysInfo.ratedBhp || 'N/A'}</div>
                <div><span className="text-zinc-400">Voltage:</span> {sysInfo.voltage || 'N/A'}</div>
              </div>
            </div>

            <div className="space-y-3">
              <h4 className="text-red-500 font-black uppercase text-sm border-b border-zinc-800 pb-1">Test Results vs NFPA Standards</h4>
              
              <div className="bg-zinc-900 p-3 rounded border border-zinc-800 flex justify-between items-center text-sm font-mono">
                <div>
                  <div className="font-bold text-white">0% Churn Point</div>
                  <div className="text-xs text-zinc-400">{getStageTotalGpm('churn')} GPM | Net PSI: {churnNet}</div>
                </div>
                <span className={`px-2 py-1 rounded text-xs font-bold ${churnPass ? 'bg-green-900 text-green-300 border border-green-700' : 'bg-red-900 text-red-300 border border-red-700'}`}>
                  {churnPass ? 'PASS' : 'CHECK'}
                </span>
              </div>

              <div className="bg-zinc-900 p-3 rounded border border-zinc-800 flex justify-between items-center text-sm font-mono">
                <div>
                  <div className="font-bold text-white">100% Rated Point</div>
                  <div className="text-xs text-zinc-400">{getStageTotalGpm('rated')} GPM | Net PSI: {ratedNet}</div>
                </div>
                <span className={`px-2 py-1 rounded text-xs font-bold ${ratedPass ? 'bg-green-900 text-green-300 border border-green-700' : 'bg-red-900 text-red-300 border border-red-700'}`}>
                  {ratedPass ? 'PASS' : 'CHECK'}
                </span>
              </div>

              <div className="bg-zinc-900 p-3 rounded border border-zinc-800 flex justify-between items-center text-sm font-mono">
                <div>
                  <div className="font-bold text-white">150% Peak Point</div>
                  <div className="text-xs text-zinc-400">{getStageTotalGpm('peak')} GPM | Net PSI: {peakNet}</div>
                </div>
                <span className={`px-2 py-1 rounded text-xs font-bold ${peakPass ? 'bg-green-900 text-green-300 border border-green-700' : 'bg-red-900 text-red-300 border border-red-700'}`}>
                  {peakPass ? 'PASS' : 'CHECK'}
                </span>
              </div>
            </div>

            <div className={`p-4 rounded border text-center font-black uppercase tracking-wider text-sm ${overallPass ? 'bg-green-950 border-green-600 text-green-400' : 'bg-red-950 border-red-600 text-red-400'}`}>
              Overall Status: {overallPass ? 'COMPLIANT (PASS)' : 'REVIEW REQUIRED'}
            </div>
          </div>
        </ModalShell>
      )}

      {/* 6. About App Modal */}
      {activeModal === 'about' && (
        <ModalShell title="About Affinity App" onClose={() => setActiveModal(null)}>
          <div className="space-y-4 text-sm text-zinc-300">
            <div>
              <span className="font-black text-red-500 uppercase">Creator:</span>
              <p className="mt-1 font-mono text-white">u/ronthorns</p>
            </div>
            <div>
              <span className="font-black text-red-500 uppercase">Purpose & Design:</span>
              <p className="mt-1">Affinity is a specialized, mobile-friendly, high-contrast web application built for field-testing fire pumps with strict adherence to NFPA 20 and NFPA 25 compliance protocols.</p>
            </div>
            <div>
              <span className="font-black text-red-500 uppercase">Protocols & Processes Used:</span>
              <ul className="list-disc list-inside mt-1 space-y-1 text-xs text-zinc-400 font-mono">
                <li>NFPA 20 Standard for the Installation of Stationary Pumps for Fire Protection.</li>
                <li>NFPA 25 Standard for the Inspection, Testing, and Maintenance of Water-Based Fire Protection Systems.</li>
                <li>Hydraulic discharge formulas utilizing Pitot pressure and nozzle K-factors.</li>
                <li>Pump Affinity Laws for speed, flow, head, and brake horsepower (BHP) performance scaling.</li>
              </ul>
            </div>
          </div>
        </ModalShell>
      )}

    </div>
  );
}
