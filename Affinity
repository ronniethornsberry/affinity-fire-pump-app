              />
            </div>
          </div>

          <div className="pt-2 flex flex-col items-center">
            {recommendError && (
              <p className="text-red-500 font-bold text-xs uppercase tracking-wider mb-2 text-center animate-pulse">{recommendError}</p>
            )}
            <button 
