              />
            </div>
            <div>
              <label className="block text-xs font-bold uppercase text-red-400 mb-1">Rated FLA</label>
              <input 
                type="number" 
                value={sysInfo.ratedFla} 
                onChange={(e) => handleSysInfoChange('ratedFla', e.target.value)}
                placeholder="e.g. 95"
                className="w-full bg-black border border-red-600 rounded p-2 text-white font-mono focus:outline-none focus:border-white"
              />
            </div>
            <div>
              <label className="block text-xs font-bold uppercase text-red-400 mb-1">Voltage</label>
              <input 
                type="number" 
                value={sysInfo.voltage} 
                onChange={(e) => handleSysInfoChange('voltage', e.target.value)}
