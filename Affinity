// ==================== FLOW STAGE CARD ====================
const FlowStageCard = React.memo(({ meta, data, onUpdate }) => {
  const handleInputChange = (field, val) => onUpdate(meta.key, { ...data, [field]: val });
  
  const handleHoseChange = (index, field, val) => {
    const newHoses = [...data.hoses];
    newHoses[index] = { ...newHoses[index], [field]: val };
    onUpdate(meta.key, { ...data, hoses: newHoses });
  };

  const addHose = () => onUpdate(meta.key, { ...data, hoses: [...data.hoses, { pitot: '', nozzle: '1.0', coeff: '0.97' }] });
  const removeHose = (index) => onUpdate(meta.key, { ...data, hoses: data.hoses.filter((_, i) => i !== index) });

  const totalGpm = data.hoses.reduce((sum, h) => {
    const p = parseFloat(h.pitot) || 0;
    const d = parseFloat(h.nozzle) || 1.0;
    const c = parseFloat(h.coeff) || 0.97;
    if (p <= 0) return sum;
    return sum + Math.round(29.83 * c * Math.pow(d, 2) * Math.sqrt(p));
  }, 0);

  const discPsi = parseFloat(data.dischargePsi) || 0;
  const sucPsi = parseFloat(data.suctionPsi) || 0;
  const netPsi = discPsi - sucPsi;

  return (
    <div className="bg-black border-2 border-red-600 rounded-lg p-4 space-y-4 shadow-md">
      <div className="border-b border-red-600 pb-2 flex justify-between items-center">
        <h3 className="font-black text-red-500 uppercase tracking-wide">{meta.title}</h3>
        <span className="text-xs bg-red-600 text-white px-2 py-1 rounded font-bold">Total GPM: {totalGpm}</span>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label className="block text-xs font-bold uppercase text-red-400 mb-1">Discharge Pressure (PSI)</label>
          <input 
            type="number" 
            value={data.dischargePsi} 
            onChange={(e) => handleInputChange('dischargePsi', e.target.value)}
            className="w-full bg-black border border-red-600 rounded p-2 text-white font-mono focus:outline-none focus:border-white"
          />
        </div>
        <div>
          <label className="block text-xs font-bold uppercase text-red-400 mb-1">Suction Pressure (PSI)</label>
          <input 
            type="number" 
            value={data.suctionPsi} 
            onChange={(e) => handleInputChange('suctionPsi', e.target.value)}
            className="w-full bg-black border border-red-600 rounded p-2 text-white font-mono focus:outline-none focus:border-white"
          />
        </div>
      </div>

      <div className="bg-zinc-900 p-3 rounded border border-zinc-800 space-y-3">
        <div className="flex justify-between items-center">
          <span className="text-xs font-bold text-red-400 uppercase">Discharge Hoses / Nozzles</span>
          <button onClick={addHose} className="bg-red-600 text-white text-xs font-bold px-2 py-1 rounded hover:bg-red-700">+ Add Hose</button>
        </div>

        {data.hoses.map((hose, idx) => {
          const p = parseFloat(hose.pitot) || 0;
          const d = parseFloat(hose.nozzle) || 1.0;
          const c = parseFloat(hose.coeff) || 0.97;
          const hoseGpm = p > 0 ? Math.round(29.83 * c * Math.pow(d, 2) * Math.sqrt(p)) : 0;

          return (
            <div key={idx} className="grid grid-cols-1 sm:grid-cols-4 gap-2 items-center bg-black p-2 rounded border border-red-900">
              <div>
                <label className="block text-[10px] text-zinc-400 uppercase">Pitot (PSI)</label>
                <input 
                  type="number" 
                  value={hose.pitot} 
                  onChange={(e) => handleHoseChange(idx, 'pitot', e.target.value)}
                  placeholder="0" 
                  className="w-full bg-black border border-red-600 rounded p-1 text-white text-sm font-mono"
                />
              </div>
              <div>
                <label className="block text-[10px] text-zinc-400 uppercase">Nozzle Size</label>
                <select 
                  value={hose.nozzle} 
                  onChange={(e) => handleHoseChange(idx, 'nozzle', e.target.value)}
                  className="w-full bg-black border border-red-600 rounded p-1 text-white text-sm"
                >
                  {NOZZLE_SIZES.map(n => <option key={n.value} value={n.value}>{n.label}</option>)}
                </select>
              </div>
              <div>
                <label className="block text-[10px] text-zinc-400 uppercase">Coefficient</label>
                <select 
                  value={hose.coeff} 
                  onChange={(e) => handleHoseChange(idx, 'nozzle', e.target.value)}
                  className="w-full bg-black border border-red-600 rounded p-1 text-white text-sm"
                >
                  {COEFFICIENTS.map(co => <option key={co.value} value={co.value}>{co.label}</option>)}
                </select>
              </div>
              <div className="flex justify-between items-center sm:justify-end space-x-2">
                <span className="text-xs font-mono text-red-500 font-bold">{hoseGpm} GPM</span>
                {data.hoses.length > 1 && (
                  <button onClick={() => removeHose(idx)} className="bg-red-900 text-white text-xs px-2 py-1 rounded">X</button>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <div className="flex justify-between items-center pt-2 border-t border-zinc-800 text-sm font-mono">
        <span className="text-zinc-400">Calculated Net Pressure:</span>
        <span className="text-red-500 font-bold">{netPsi} PSI</span>
      </div>
    </div>
  );
});

// ==================== MAIN APP COMPONENT ====================
export default function App() {
  const [activeModal, setActiveModal] = useState(null); // null, 'definitions', 'formulas', 'vertical', 'recommend', 'report', 'about'

  // Unified Pump & System Info State (All default blank)
  const [sysInfo, setSysInfo] = useState({
    ratedGpm: '',
    ratedPsi: '',
    ratedHead: '',
    ratedRpm: '',
    ratedBhp: '',
    ratedFla: '',
    voltage: '',
    phases: '3',
    frequency: '60',
    controllerType: 'Electric Motor',
    suctionSource: 'Municipal Water Main',
    testLocation: ''
  });

  // Flow Stage Test Data States (All default blank)
  const [stages, setStages] = useState({
    churn: { dischargePsi: '', suctionPsi: '', hoses: [{ pitot: '', nozzle: '1.0', coeff: '0.97' }] },
    rated: { dischargePsi: '', suctionPsi: '', hoses: [{ pitot: '', nozzle: '1.0', coeff: '0.97' }] },
    peak: { dischargePsi: '', suctionPsi: '', hoses: [{ pitot: '', nozzle: '1.0', coeff: '0.97' }] }
  });

  const [recommendError, setRecommendError] = useState('');
  const [recommendedSetup, setRecommendedSetup] = useState(null);

  // Two-way conversion for PSI and Head
  const handleSysInfoChange = useCallback((field, val) => {
    setSysInfo(prev => {
      const updated = { ...prev, [field]: val };
      if (field === 'ratedPsi') {
        if (val === '') {
          updated.ratedHead = '';
        } else {
          const psi = parseFloat(val);
          updated.ratedHead = !isNaN(psi) ? (psi * 2.31).toFixed(1) : '';
        }
      } else if (field === 'ratedHead') {
        if (val === '') {
          updated.ratedPsi = '';
        } else {
          const head = parseFloat(val);
          updated.ratedPsi = !isNaN(head) ? (head / 2.31).toFixed(1) : '';
        }
      }
      return updated;
    });
  }, []);

  const handleStageUpdate = useCallback((stageKey, newData) => {
    setStages(prev => ({ ...prev, [stageKey]: newData }));
  }, []);

  // Recommend Setup Logic with Validation
  const handleOpenRecommend = () => {
    if (!sysInfo.ratedGpm || sysInfo.ratedGpm.trim() === '') {
      setRecommendError('ERROR: Please input Rated GPM in Pump & System Info before generating recommendations.');
      return;
    }
    setRecommendError('');
    const gpm = parseFloat(sysInfo.ratedGpm);
    
    // Calculate recommended test parameters based on NFPA 25
    setRecommendedSetup({
      churnGpm: 0,
      ratedGpm: gpm,
      peakGpm: Math.round(gpm * 1.5),
      churnPitot: '0',
      ratedPitot: '50',
      peakPitot: '45',
      note: 'Based on your Rated GPM of ' + gpm + ' GPM, configure your test header with the recommended nozzle configurations below to achieve accurate NFPA test points.'
    });
    setActiveModal('recommend');
  };

  // Calculations for Final Report
  const getStageTotalGpm = (stageKey) => {
    return stages[stageKey].hoses.reduce((sum, h) => {
      const p = parseFloat(h.pitot) || 0;
      const d = parseFloat(h.nozzle) || 1.0;
      const c = parseFloat(h.coeff) || 0.97;
      if (p <= 0) return sum;
      return sum + Math.round(29.83 * c * Math.pow(d, 2) * Math.sqrt(p));
    }, 0);
  };

  const churnNet = (parseFloat(stages.churn.dischargePsi) || 0) - (parseFloat(stages.churn.suctionPsi) || 0);
  const ratedNet = (parseFloat(stages.rated.dischargePsi) || 0) - (parseFloat(stages.rated.suctionPsi) || 0);
  const peakNet = (parseFloat(stages.peak.dischargePsi) || 0) - (parseFloat(stages.peak.suctionPsi) || 0);

  const ratedPsiVal = parseFloat(sysInfo.ratedPsi) || 1;
  const churnPass = churnNet >= (ratedPsiVal * 1.0) && churnNet <= (ratedPsiVal * 1.4);
  const ratedPass = ratedNet >= ratedPsiVal;
  const peakPass = peakNet >= (ratedPsiVal * 0.65);
  const overallPass = churnPass && ratedPass && peakPass;

  return (
    <div className="min-h-screen bg-black text-white font-sans antialiased selection:bg-red-600 selection:text-white pb-16">
      {/* HEADER */}
      <header className="border-b-2 border-red-600 bg-black sticky top-0 z-40 p-4 shadow-lg">
        <div className="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
          <div>
            <h1 className="text-2xl font-black uppercase tracking-widest text-red-600">AFFINITY</h1>
            <p className="text-xs text-zinc-400 font-mono tracking-wider">NFPA 20/25 Fire Pump Field-Testing Suite</p>
          </div>
          <div className="flex flex-wrap gap-2">
            <button onClick={() => setActiveModal('definitions')} className="bg-zinc-900 border border-red-600 hover:bg-red-600 text-xs font-bold uppercase px-3 py-1.5 rounded transition">Definitions</button>
            <button onClick={() => setActiveModal('formulas')} className="bg-zinc-900 border border-red-600 hover:bg-red-600 text-xs font-bold uppercase px-3 py-1.5 rounded transition">Formulas</button>
            <button onClick={() => setActiveModal('vertical')} className="bg-zinc-900 border border-red-600 hover:bg-red-600 text-xs font-bold uppercase px-3 py-1.5 rounded transition">Vertical Turbine Guide</button>
          </div>
        </div>
      </header>

      {/* MAIN CONTAINER */}
      <main className="max-w-7xl mx-auto p-4 space-y-6">
        
        {/* UNIFIED PUMP & SYSTEM INFO CARD */}
        <section className="bg-black border-2 border-red-600 rounded-lg p-4 shadow-xl space-y-4">
          <div className="border-b border-red-600 pb-2 flex justify-between items-center">
            <h2 className="font-black text-red-500 uppercase tracking-wide">Pump & System Info</h2>
            <span className="text-xs bg-red-600 text-white px-2 py-1 rounded font-bold">NFPA 20 / 25 Compliant</span>
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            <div>
              <label className="block text-xs font-bold uppercase text-red-400 mb-1">Rated GPM</label>
              <input 
                type="number" 
                value={sysInfo.ratedGpm} 
                onChange={(e) => {
                  handleSysInfoChange('ratedGpm', e.target.value);
                  if (recommendError) setRecommendError('');
                }}
                placeholder="e.g. 1000"
                className="w-full bg-black border border-red-600 rounded p-2 text-white font-mono focus:outline-none focus:border-white"
              />
            </div>
            <div>
              <label className="block text-xs font-bold uppercase text-red-400 mb-1">Rated PSI</label>
              <input 
                type="number" 
                value={sysInfo.ratedPsi} 
                onChange={(e) => handleSysInfoChange('ratedPsi', e.target.value)}
                placeholder="e.g. 100"
                className="w-full bg-black border border-red-600 rounded p-2 text-white font-mono focus:outline-none focus:border-white"
              />
            </div>
            <div>
              <label className="block text-xs font-bold uppercase text-red-400 mb-1">Rated Head (ft)</label>
              <input 
                type="number" 
                value={sysInfo.ratedHead} 
                onChange={(e) => handleSysInfoChange('ratedHead', e.target.value)}
                placeholder="e.g. 231"
                className="w-full bg-black border border-red-600 rounded p-2 text-white font-mono focus:outline-none focus:border-white"
              />
            </div>
            <div>
              <label className="block text-xs font-bold uppercase text-red-400 mb-1">Rated RPM</label>
              <input 
                type="number" 
                value={sysInfo.ratedRpm} 
                onChange={(e) => handleSysInfoChange('ratedRpm', e.target.value)}
                placeholder="e.g. 1760"
                className="w-full bg-black border border-red-600 rounded p-2 text-white font-mono focus:outline-none focus:border-white"
              />
            </div>
            <div>
              <label className="block text-xs font-bold uppercase text-red-400 mb-1">Brake HP (BHP)</label>
              <input 
                type="number" 
